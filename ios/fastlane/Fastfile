default_platform(:ios)

platform :ios do
  desc "Build & upload to TestFlight (CI)"
  lane :ci_release do
    # Flutter build (без подписи), номер билда берём из ENV
    sh("cd .. && flutter clean && flutter -v build ios --release --no-codesign --build-number #{ENV['BUILD_NUMBER'] || '1'}")

    match(type: "appstore", readonly: true)

    build_ios_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
