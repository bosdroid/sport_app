app_identifier("com.drillbox.app")
team_id(ENV["APPLE_TEAM_ID"])

opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Build & upload to TestFlight (CI)"
  lane :ci_release do
    # Один API-ключ для всех взаимодействий с App Store Connect
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    UI.header("1/4 match (certs & profiles)")
    git_url = ENV["MATCH_GIT_URL"]
    git_url = "git@github.com:bosdroid/ios-certs.git" if git_url.nil? || git_url.empty?

    match(
      type: "appstore",
      readonly: false,                                 # первый прогон создаст сертификаты/профили
      git_url: git_url,                                # SSH-URL хранилища match
      git_branch: ENV["MATCH_GIT_BRANCH"] || "main",
      git_private_key: ENV["MATCH_SSH_KEY"],           # содержимое приватного ключа deploy key
      app_identifier: "com.drillbox.app",
      api_key: api_key
    )
    UI.success("match done")

    UI.header("2/4 enforce signing (manual, distribution)")
    # Ставим командно те же настройки, чтобы не было конфликта auto/manual
    update_project_team(
      path: "Runner.xcodeproj",
      teamid: ENV["APPLE_TEAM_ID"]
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.drillbox.app",
      team_id: ENV["APPLE_TEAM_ID"]
    )

    UI.header("3/4 build_ios_app (archive & export)")
    build_ios_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Manual",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.drillbox.app" => "match AppStore com.drillbox.app"
        }
      },
      disable_xcpretty: true # печатаем сырой xcodebuild-лог в консоль
    )
    UI.success("build_ios_app done")

    UI.header("4/4 upload_to_testflight")
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
    UI.success("upload_to_testflight done")
  end
end
